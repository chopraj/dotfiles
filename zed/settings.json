// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "format_on_save": "on",
    "excerpt_context_lines": 3,
    "expand_excerpt_lines": 7,
    "vertical_scroll_margin": 50.0,
    "minimum_contrast_for_highlights": 80.0,
    "diff_view_style": "split",
    "buffer_font_weight": 400.0,
    "preview_tabs": {
        "enabled": false,
    },
    "minimap": {
        "show": "never",
    },
    "auto_signature_help": false,
    "autoscroll_on_clicks": false,
    "colorize_brackets": false,
    "indent_guides": {
        "coloring": "fixed",
        "background_coloring": "disabled",
        "active_line_width": 1,
        "line_width": 1,
        "enabled": true,
    },
    "vim": {
        "toggle_relative_line_numbers": false,
        "use_system_clipboard": "never",
    },
    "tab_size": 2,
    "relative_line_numbers": "disabled",
    "toolbar": {
        "agent_review": false,
        "selections_menu": false,
        "quick_actions": false,
        "breadcrumbs": true,
    },
    "gutter": {
        "bookmarks": false,
        "breakpoints": false,
        "runnables": false,
        "min_line_number_digits": 3,
    },
    "hover_popover_delay": 100,
    "mouse_wheel_zoom": false,
    "scroll_beyond_last_line": "off",
    "which_key": {
        "delay_ms": 100,
        "enabled": true,
    },
    "proxy": "",
    "file_finder": {
        "include_ignored": "all",
        "modal_max_width": "medium",
    },
    "use_smartcase_search": false,
    "active_pane_modifiers": {
        "inactive_opacity": 1.0,
        "border_size": 1.0,
    },
    "use_system_window_tabs": false,
    "focus_follows_mouse": {
        "enabled": false,
    },
    "bottom_dock_layout": "contained",
    "tabs": {
        "show_diagnostics": "errors",
        "file_icons": true,
        "git_status": true,
    },
    "tab_bar": {
        "show_pinned_tabs_in_separate_row": true,
        "show_tab_bar_buttons": false,
        "show_nav_history_buttons": false,
        "show": true,
    },
    "title_bar": {
        "show_user_picture": true,
        "show_menus": false,
        "show_project_items": true,
        "show_branch_status_icon": false,
    },
    "debugger": {
        "button": false,
    },
    "search": {
        "button": false,
    },
    "diagnostics": {
        "button": false,
    },
    "terminal": {
        "button": false,
    },
    "status_bar": {
        "active_language_button": false,
        "show_active_file": true,
        "cursor_position_button": false,
        "active_encoding_button": "disabled",
    },
    "git": {
        "blame": {
            "show_avatar": true,
        },
        "inline_blame": {
            "delay_ms": 1000,
            "show_commit_summary": true,
        },
    },
    "buffer_line_height": "comfortable",
    "project_panel": {
        "button": true,
        "hide_root": true,
        "git_status_indicator": true,
        "bold_folder_labels": false,
        "entry_spacing": "standard",
        "dock": "left",
    },
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "button": false,
        "dock": "left",
    },
    "git_panel": {
        "group_by": "none",
        "tree_view": true,
        "show_count_badge": true,
        "fallback_branch_name": "main",
        "dock": "left",
    },
    "agent_servers": {
        "claude-acp": {
            "default_config_options": {
                "mode": "bypassPermissions",
            },
            "favorite_config_option_values": {
                "effort": ["max"],
            },
            "type": "registry",
        },
        "codex-acp": {
            "type": "registry",
        },
    },
    "buffer_font_family": "Berkeley Mono",
    "session": {
        "trust_all_worktrees": true,
    },
    "agent": {
        "sidebar_side": "right",
        "message_editor_min_lines": 4,
        "expand_terminal_card": false,
        "use_modifier_to_send": true,
        "show_turn_stats": true,
        "play_sound_when_agent_done": "always",
        "button": true,
        "dock": "right",
        "default_model": {
            "provider": "anthropic",
            "model": "claude-sonnet-4-5-latest",
        },
        "favorite_models": [],
        "model_parameters": [],
    },
    "helix_mode": false,
    "vim_mode": true,
    "icon_theme": {
        "mode": "dark",
        "light": "Bearded Icon Theme",
        "dark": "Material Icon Theme",
    },
    "base_keymap": "Cursor",
    "ui_font_family": "Berkeley Mono",
    "ui_font_size": 18.0,
    "buffer_font_size": 15.0,
    "theme": {
        "mode": "dark",
        "light": "GitHub Light",
        "dark": "Kanagawa Wave",
    },
    "theme_overrides": {
        "Vague": {
            "tab.inactive_background": "#2a2a32",
            "editor.active_line.background": "#2a2a39",
            "editor.subheader.background": "#2a2d36",
        },
        "Kanso Ink (Borderless + No italics)": {
            "editor.subheader.background": "#2a2d36",
        },
        "Kanagawa Wave Blur": {
            "editor.subheader.background": "#2a2d36",
        },
    },
}
